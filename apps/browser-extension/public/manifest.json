{
  "manifest_version": 3,
  "name": "CapKit Inspector",
  "version": "0.3.0",
  "description": "Inspect spacing, styles and source locations, comment on elements for AI agents, read fonts and pick colours on any page.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "CapKit Inspector",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "alarms", "scripting", "storage", "clipboardWrite", "contextMenus"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-inspector": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "Inspect the page"
    },
    "toggle-picker": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Pick elements and comment"
    },
    "toggle-font": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Read fonts"
    },
    "toggle-color": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Pick colours"
    }
  },
  "web_accessible_resources": [{ "resources": ["fonts/*"], "matches": ["<all_urls>"], "use_dynamic_url": false }]
}
