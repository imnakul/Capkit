{
  "manifest_version": 3,
  "name": "CapKit Inspector",
  "version": "0.3.0",
  "description": "Inspect spacing, styles and source locations on any page, and give CapKit exact element data.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup/index.html", "default_title": "CapKit Inspector" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "alarms", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-inspector": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "Inspect the page"
    }
  },
  "web_accessible_resources": [{ "resources": ["fonts/*"], "matches": ["<all_urls>"], "use_dynamic_url": true }]
}
