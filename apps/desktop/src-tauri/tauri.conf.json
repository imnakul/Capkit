{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snaphub",
  "version": "0.1.1",
  "identifier": "com.snaphub.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "dashboard",
        "title": "Snaphub",
        "visible": false,
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "skipTaskbar": false,
        "focus": true
      },
      {
        "label": "capture",
        "title": "Snaphub Capture",
        "visible": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/Snaphub/**", "$PICTURE/Snaphub/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "shortDescription": "Capture, explain, and continue.",
    "longDescription": "A lightweight screenshot utility with in-place quick editing."
  }
}
