{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapKit",
  "version": "0.2.1",
  "identifier": "com.snaphub.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "dashboard",
        "title": "CapKit",
        "visible": false,
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "skipTaskbar": false,
        "focus": true
      },
      {
        "label": "capture",
        "title": "CapKit Capture",
        "visible": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "transparent": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/CapKit/**",
          "$PICTURE/CapKit/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": false,
    "shortDescription": "The lightweight desktop toolkit to capture, record, and showcase.",
    "longDescription": "CapKit is a lightweight desktop toolkit to capture, record, and showcase with fast in-place editing."
  }
}
