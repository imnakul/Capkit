{
  "name": "snaphub",
  "version": "0.7.1",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "dev": "pnpm --filter @snaphub/desktop dev",
    "build": "pnpm --filter @snaphub/desktop build",
    "typecheck": "pnpm --filter @snaphub/desktop --filter @snaphub/devtools-protocol --filter @snaphub/browser-extension typecheck",
    "lint": "pnpm --filter @snaphub/desktop --filter @snaphub/devtools-protocol --filter @snaphub/browser-extension lint",
    "lint:fix": "pnpm --filter @snaphub/desktop --filter @snaphub/devtools-protocol --filter @snaphub/browser-extension lint:fix",
    "test": "pnpm --filter @snaphub/desktop --filter @snaphub/devtools-protocol --filter @snaphub/browser-extension test",
    "tauri": "pnpm --filter @snaphub/desktop tauri",
    "bundle": "pnpm --filter @snaphub/desktop bundle",
    "bundle:windows": "pnpm --filter @snaphub/desktop bundle:windows",
    "bundle:store": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-msix.ps1",
    "test:store": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-msix.ps1",
    "version:bump": "node scripts/bump-version.ts",
    "version:check": "node scripts/check-version.ts",
    "notices": "node scripts/third-party-notices.ts",
    "ext:build": "pnpm --filter @snaphub/browser-extension build",
    "ext:dev": "pnpm --filter @snaphub/browser-extension dev"
  }
}
